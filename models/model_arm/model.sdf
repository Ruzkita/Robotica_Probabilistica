<?xml version="1.0" ?>
<sdf version="1.8">

    <model name='arm' canonical_link='base'>
        <link name='base'>
            <pose relative_to='__model__'>
                0.0 0.0 0.25 0.0 0.0 0.0 <!-- x y z row pitch yaw-->
            </pose>
            <inertial>
                <mass>
                    1.14395 <!-- kg -->
                </mass>
                <inertia>
                    <ixx>0.095329</ixx>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyy>0.381317</iyy>
                    <iyz>0</iyz>
                    <izz>0.476646</izz>
                </inertia>
            </inertial>
            <visual name='base_visual'>
                <geometry>
                    <box>
                        <size> 2.0 2.0 0.5 </size>
                    </box>
                </geometry>
                <material>
                    <ambient>0.0 1.0 0.0 1</ambient>
                    <diffuse>0.5 0.0 1.0 1</diffuse>
                    <specular>1.0 0.0 0.5 1</specular>
                </material>
            </visual>
            <collision name='base_collision'>
                <geometry>
                    <box>
                        <size>2.0 2.0 0.5</size>
                    </box>
                </geometry>
            </collision>
        </link>

        <link name='joint1'>
            <pose relative_to='base'>
                0.0 0.0 0.30 0.0 0.0 0.0
            </pose>
            <inertial>
                <mass>
                    1.14395 <!-- kg -->
                </mass>
                <inertia>
                    <ixx>0.095329</ixx>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyy>0.381317</iyy>
                    <iyz>0</iyz>
                    <izz>0.476646</izz>
                </inertia>
            </inertial>
            <visual name='joint1_visual'>
                <geometry>
                    <cylinder>
                        <radius>0.1</radius>
                        <length>0.1</length>
                    </cylinder>
                </geometry>
                <material>
                    <ambient>0.5 0.0 0.0 1</ambient>
                    <diffuse>1.0 0.0 0.0 1</diffuse>
                    <specular>0.3 0.3 0.3 1</specular>
                </material>
            </visual>
            <collision name='joint1_collision'>
                <geometry>
                    <cylinder>
                        <radius>0.1</radius>
                        <length>0.1</length>
                    </cylinder>
                </geometry>
            </collision>
        </link>

        <link name='link1'>
            <pose relative_to='joint1'>
                0.0 0.0 0.175 0.0 0.0 0.0
            </pose>
            <inertial>
                <mass>
                    1.14395 <!-- kg -->
                </mass>
                <inertia>
                    <ixx>0.095329</ixx>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyy>0.381317</iyy>
                    <iyz>0</iyz>
                    <izz>0.476646</izz>
                </inertia>
            </inertial>
            <visual name='link1_visual'>
                <geometry>
                    <cylinder>
                        <radius>0.1</radius>
                        <length>0.25</length>
                    </cylinder>
                </geometry>
                <material>
                    <ambient>0.0 0.5 0.0 1</ambient>
                    <diffuse>0.0 1.0 0.0 1</diffuse>
                    <specular>0.1 0.1 0.1 1</specular>
                </material>
            </visual>
            <collision name='link1_collision'>
                <geometry>
                    <cylinder>
                        <radius>0.1</radius>
                        <length>0.25</length>
                    </cylinder>
                </geometry>
            </collision>
        </link>

        <link name='joint2'>
            <pose relative_to='link1'>
                0.0 0.0 0.125 1.5708 0.0 0.0
            </pose>
            <inertial>
                <mass>
                    1.14395 <!-- kg -->
                </mass>
                <inertia>
                    <ixx>0.095329</ixx>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyy>0.381317</iyy>
                    <iyz>0</iyz>
                    <izz>0.476646</izz>
                </inertia>
            </inertial>
            <visual name='joint2_visual'>
                <geometry>
                    <cylinder>
                        <radius>0.1</radius>
                        <length>0.2</length>
                    </cylinder>
                </geometry>
                <material>
                    <ambient>0.5 0.0 0.0 1</ambient>
                    <diffuse>1.0 0.0 0.0 1</diffuse>
                    <specular>0.3 0.3 0.3 1</specular>
                </material>
            </visual>
            <collision name='joint2_collision'>
                <geometry>
                    <cylinder>
                        <radius>0.1</radius>
                        <length>0.2</length>
                    </cylinder>
                </geometry>
            </collision>
        </link>

        <link name='link2'>
            <pose relative_to='joint2'>
                0.0 0.8 0.0 1.5708 0.0 0.0
            </pose>
            <inertial>
                <mass>
                    1.14395 <!-- kg -->
                </mass>
                <inertia>
                    <ixx>0.095329</ixx>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyy>0.381317</iyy>
                    <iyz>0</iyz>
                    <izz>0.476646</izz>
                </inertia>
            </inertial>
            <visual name='link2_visual'>
                <geometry>
                    <cylinder>
                        <radius>0.1</radius>
                        <length>1.5</length>
                    </cylinder>
                </geometry>
                <material>
                    <ambient>0.0 0.5 0.0 1</ambient>
                    <diffuse>0.0 1.0 0.0 1</diffuse>
                    <specular>0.1 0.1 0.1 1</specular>
                </material>
            </visual>
            <collision name='link2_collision'>
                <geometry>
                    <cylinder>
                        <radius>0.1</radius>
                        <length>1.5</length>
                    </cylinder>
                </geometry>
            </collision>
        </link>


        <joint name='joint1_base' type='revolute'>
            <pose relative_to='base'>0 0 0.25 0 0 0</pose>
            <parent>base</parent>
            <child>joint1</child>
            <axis>
                <xyz expressed_in='base'>0.0 0.0 1</xyz>
                <limit>
                    <lower>-1.79769</lower>   
                    <upper>1.79769</upper>  
                    <effort>inf</effort>
                    <velocity>inf</velocity>   
                </limit>
            </axis>
        </joint>

        <joint name='joint1_link1' type='fixed'>
            <pose relative_to='joint1'>0 0 0.0 0 0 0</pose>
            <parent>joint1</parent>
            <child>link1</child>
        </joint>

        <joint name='link1_joint2' type='revolute'>
            <pose relative_to='link1'>0 0 0.125 0 0 0</pose>
            <parent>link1</parent>
            <child>joint2</child>
            <axis>
                <xyz expressed_in='link1'>0 1 0</xyz>
                <limit>
                    <lower>-1.5</lower>   
                    <upper>1.5</upper>   
                    <effort>inf</effort>
                    <velocity>inf</velocity>  
                </limit>
            </axis>
            <dynamics>
                <damping>0.01</damping>
            </dynamics>
        </joint>

        <joint name='joint2_link2' type='fixed'>
            <pose relative_to='joint2'>0 0 0 1.5708 0 0</pose>
            <parent>joint2</parent>
            <child>link2</child>
        </joint>

        <plugin filename="libignition-gazebo6-joint-position-controller-system.so" name='ignition::gazebo::systems::JointPositionController'>
            <joint_name>joint1_base</joint_name>
            <topic>link1_joint2</topic>
            <p_gain>1</p_gain>
            <i_gain>0.1</i_gain>
            <d_gain>0.01</d_gain>
            <cmd_max>100</cmd_max>
            <cmd_min>-100</cmd_min>
        </plugin>


    </model>

</sdf>